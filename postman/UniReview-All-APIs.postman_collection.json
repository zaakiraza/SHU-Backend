      ]
    },
    {
      "name": "Universities",
      "item": [
        {
          "name": "List Universities",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/universities?page=1&limit=10"
          }
        },
        {
          "name": "Get Pending Universities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/universities/pending"
          }
        },
        {
          "name": "Get University By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/universities/{{universityId}}"
          }
        },
        {
          "name": "Create University",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"University Name\",\n  \"description\": \"Description\",\n  \"location\": \"City\",\n  \"website\": \"https://example.edu\",\n  \"emailDomain\": \"example.edu\",\n  \"logo\": \"\"\n}"
            },
            "url": "{{baseUrl}}/api/universities"
          }
        },
        {
          "name": "Approve University",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/universities/{{universityId}}/approve"
          }
        },
        {
          "name": "Reject University",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Insufficient verification details\"\n}"
            },
            "url": "{{baseUrl}}/api/universities/{{universityId}}/reject"
          }
        }
      ]
    },
